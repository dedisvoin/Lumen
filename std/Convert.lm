#pragma once

#include "std/Typing.lm"
#cppinclude "std/_Convert.cpp"

extern fn to_raf_int(s: str | char) -> ?i64  : { null };
extern fn to_raf_float(s: str | char) -> ?f64  : { null };
extern fn to_raf_str(v: any) -> ?str  : { null };


final const let COMP_TIME_STR = "~cts~";

/*
Преобразует строку в целое число i64.

Разбираются необязательный знак (`+`/`-`) и десятичные цифры; окружающие
пробелы и переводы строк отбрасываются. Никакие другие символы не допускаются:
если после цифр остался мусор, возвращается 0.

```lumen
let n = to_int("42");      // 42
let m = to_int("  -7  ");  // -7
let bad = to_int("3.14");  // 0 — это не целое
let txt = to_int("abc");   // 0
```

Параметры:
- s (str | char) — разбираемая строка.

Возвращает:
- CompileTime[i64] — разобранное число. Результат НЕ nullable: при неудачном
  разборе возвращается 0, а не null. Если нужно отличить «не число» от нуля,
  используйте `to_raf_int`, который возвращает `?i64` (null при неудаче).
*/
fn to_int(s: str | char) -> CompileTime[i64]  : {
    ret CompileTime::from[i64](to_raf_int(s) ?? 0);
}




/*
Преобразует строку в дробное число f64.

Разбираются необязательный знак, целая и дробная части (разделитель — точка)
и экспонента `e`/`E` с необязательным знаком. Окружающие пробелы
отбрасываются. Целая строка без точки тоже допустима: `"42"` → `42.0`.

```lumen
let a = to_float("3.14");    // 3.140000
let b = to_float("-0.5");    // -0.500000
let c = to_float("1e3");     // 1000.000000
let d = to_float("42");      // 42.000000
let e = to_float("3.14x");   // null — после числа остался мусор
```

Параметры:
- s (str | char) — разбираемая строка.

Возвращает:
- CompileTime[?f64] — разобранное число; value = null, если строка не является
  числом (в том числе при переполнении в бесконечность).
*/
fn to_float(s: str | char) -> CompileTime[f64]  : {
    ret CompileTime::from[f64](to_raf_float(s) ?? 0.0);
}


/*
Преобразует значение любого типа в строку.

Формат совпадает с тем, что печатает `outln`: целые значения — без дробной
части, дробные — с шестью знаками после точки, `str` — как есть, `bool` —
`"true"`/`"false"`, `null` — `"null"`, массив — `{a, b}`, кортеж — `[a, b]`,
структура — `object(Имя)`, замыкание — `"fn"`.

```lumen
let a = to_str(42);            // "42"
let b = to_str(3.14);          // "3.140000"
let c = to_str(7 as i32);      // "7"
let d = to_str(true);          // "true"
let e = to_str("уже строка");  // "уже строка"
let f = to_str({1, 2, 3});     // "{1, 2, 3}"
let g = to_str(3.5?);          // "3.500000"
```

Целое число вида 42.0 тоже печатается как "42" (без `.000000`) — так же,
как `outln 42.0`. Для фиксированного числа знаков используйте форматирование
вручную.

Обёртки (`CompileTime` и подобные) не разворачиваются: `to_str(to_int("10"))`
даст `"object(CompileTime)"`. Чтобы получить значение, разверните его явно —
`to_str(to_int("10")?)` даст `"10"`.

Параметры:
- v (любой тип) — исходное значение. Ссылочные ячейки и heap-указатели
  разыменовываются перед форматированием.

Возвращает:
- CompileTime[str] — строковое представление значения.
*/
fn to_str(v: any) -> CompileTime[str]  : {
    ret CompileTime::from[str](to_raf_str(v) ?? COMP_TIME_STR);
}


