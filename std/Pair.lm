#include "std/Typing.lm"
struct[FirstT, SecondT] Pair {
    let _box: Tuple[FirstT, SecondT] = !{};

    static fn from[A, B](first: A, second: B) -> Pair[A, B] : 
        ret Pair[A, B]{_box: !{first, second}};
    

    fn first(ref self: Pair[FirstT, SecondT]) -> FirstT : ret self._box[0]; 
    fn second(ref self: Pair[FirstT, SecondT]) -> SecondT : ret self._box[1]; 

    fn __get_index__(ref self: Pair[FirstT, SecondT], index: Numeric) -> FirstT | SecondT : {
        if (index == 0) ret self._box[0];
        else if (index == 1) ret self._box[1];
        else assert false, "bad index";
    }

    fn __of__(ref self: Pair[FirstT, SecondT]) -> ref Tuple[FirstT, SecondT] :  ret self._box; 
}
