#pragma once

#include "std/Typing.lm"

struct[FirstT: Type, SecondT: Type] Pair {
    final strict let first: FirstT;
    final strict let second: SecondT;
    
    static fn from[A, B](first: A, second: B) -> Pair[A, B]  : {
        ret Pair[A, B]{first:  first, second:  second};
    }
    
    const fn swap(self) -> Pair[SecondT, FirstT]  : {
        ret Pair[SecondT, FirstT]{
            first_: self.second_, 
            second_: self.first_
        };
    }
    
    fn __get_index__(ref self, index: Numeric) -> FirstT | SecondT  : {
        if (index == 0) ret self.first;
        else if (index == 1) ret self.second;
        else assert false, "Ivalid index, must be 0 or 1.";
    }
}
