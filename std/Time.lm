#pragma once
#include "std/Typing.lm"
#cppinclude "std/_Time.cpp"


extern fn raf_time() -> CompileTime[f64]  : { CompileTime::from(0.0) };
extern fn raf_clock() -> CompileTime[i64]  : { CompileTime::from(0) };
extern fn raf_sleep(seconds: Numeric) -> CompileTime[bool]  : { CompileTime::from(false) };



final namespace Time {
/*
Возвращает текущее время Unix (эпоха) в секундах.

Отсчёт идёт от 1 января 1970 года 00:00:00 UTC. Дробная часть
содержит доли секунды. Значение зависит от системных часов и может
незначительно «прыгать» при их автоматической синхронизации.

```lumen
let t = time();
echo t;   // например 1758502584.123456
```

Возвращает:
- f64 — количество секунд с начала эпохи Unix.
*/
    fn time() -> CompileTime[f64] : {ret raf_time();}
    
/*
Возвращает монотонное время в микросекундах.

Счётчик только растёт и не привязан к системной дате: показывает
интервалы времени независимо от перевода часов и синхронизации.
Удобно для измерения времени выполнения участка кода.

```lumen
let start = clock();
sleep(0.01);
let dt = clock() - start;   // примерно 10000 микросекунд
echo dt;
```

Возвращает:
- i64 — число микросекунд с неопределённой, но стабильной точки отсчёта.
*/
    fn clock() -> CompileTime[i64] : {ret raf_clock();}
    
    
/*
Приостанавливает выполнение программы на заданное число секунд.

Принимает целые и дробные значения, в том числе смешанные типы.
Отрицательные значения и нечисловые аргументы игнорируются —
ожидание не выполняется, функция возвращает false.

```lumen
sleep(1);      // пауза 1 секунда
sleep(0.05);   // пауза 50 миллисекунд
sleep(0.1);    // дробные секунды допустимы
```

Параметры:
- seconds (i8 | i16 | i32 | i64 | f32 | f64) — длительность паузы в секундах.

Возвращает:
- true — если ожидание выполнено;
- false — если аргумент отсутствует, не является числом или отрицателен.
*/
    fn sleep(seconds: Numeric) : {ret raf_sleep(seconds);}
}

